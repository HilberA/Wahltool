rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function pollData(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data;
    }

    function isOwner(pollId) {
      return request.auth != null && pollData(pollId).ownerUid == request.auth.uid;
    }

    match /polls/{pollId} {
      // Fragestellung/Optionen/Status sind über den Link öffentlich lesbar
      // (sonst könnte der Stimmzettel gar nicht angezeigt werden).
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      match /tokens/{tokenId} {
        // Die Code-Liste selbst darf nur die Admin-Person einsehen.
        allow read: if isOwner(pollId);

        allow create: if isOwner(pollId);

        // Ein Code darf nur EINMAL von "nicht benutzt" auf "benutzt" wechseln,
        // dabei dürfen ausschließlich diese beiden Felder verändert werden – UND
        // die zugehörige Umfrage muss gerade offen sein: manuell (status == 'open')
        // UND, falls gesetzt, noch vor ihrem automatischen Ablaufzeitpunkt.
        allow update: if resource.data.used == false
                      && request.resource.data.used == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt'])
                      && pollData(pollId).status == 'open'
                      && (pollData(pollId).closesAt == null || request.time < pollData(pollId).closesAt);

        allow delete: if isOwner(pollId);
      }

      match /votes/{voteId} {
        // Stimmzettel enthalten absichtlich keinen Verweis auf den Code oder eine
        // Nutzer-Identität – nur die Antworten (eine pro Frage der Umfrage).
        allow create: if request.resource.data.keys().hasOnly(['answers', 'createdAt'])
                      && request.resource.data.answers is list
                      && request.resource.data.answers.size() == pollData(pollId).questions.size();

        allow read: if pollData(pollId).resultsVisibility == 'public' || isOwner(pollId);

        allow update: if false;
        allow delete: if isOwner(pollId);
      }
    }
  }
}
