# Werte aus der Firebase Console: Projekteinstellungen -> Allgemein -> "Meine Apps" -> Web-App
# Diese Datei zu .env kopieren und mit den echten Werten füllen. .env NICHT committen.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional (App Check / Bot-Schutz) – siehe README, Abschnitt "App Check aktivieren".
# Ohne diesen Wert läuft die App ganz normal weiter, nur ohne den zusätzlichen Schutz.
VITE_RECAPTCHA_SITE_KEY=
